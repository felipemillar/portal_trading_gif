# Credenciales para la Base de Datos Estadísticos (BDE) del Banco Central de Chile
# Obtén tu cuenta y API Key Token en https://si3.bcentral.cl

# Opción 1 (Recomendada): API Key Token personal
BCCH_TOKEN=tu_api_key_token_aqui

# Opción 2 (Clásica): Correo y contraseña
# BCCH_USER=tu_email@ejemplo.com
# BCCH_PASS=tu_contrasena_aqui

# Credenciales de Alpha Vantage
ALPHAVANTAGE_API_KEY=tu_api_key_aqui

# Credenciales de FRED
FRED_API_KEY=tu_api_key_fred_aqui
